{
  "name": "isometric-contributions-plus",
  "private": true,
  "description": "Isometric Contributions Plus browser extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/vycdev/isometric-contributions-plus.git"
  },
  "homepage": "https://github.com/vycdev/isometric-contributions-plus",
  "bugs": {
    "url": "https://github.com/vycdev/isometric-contributions-plus/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "start": "parcel watch src/manifest.json --host localhost",
    "build": "parcel build src/manifest.json",
    "build:chrome": "node scripts/build.js chrome",
    "build:edge": "node scripts/build.js edge",
    "build:firefox": "node scripts/build.js firefox",
    "build:safari": "node scripts/build-safari.js",
    "build:safari:release": "node scripts/build-safari.js --release",
    "build:all": "node scripts/build.js all",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "biome check && pnpm run test:unit && pnpm run test:tooling && pnpm run test:publishing",
    "test:unit": "vitest run",
    "test:tooling": "node --test scripts/pnpm.test.js scripts/build.test.js scripts/test-e2e.test.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:watch": "vitest",
    "version:get": "node scripts/version.js get",
    "version:set": "node scripts/version.js set",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "submit:chrome": "node scripts/submit.js chrome",
    "submit:edge": "node scripts/submit.js edge",
    "submit:firefox": "node scripts/submit.js firefox",
    "submit:firefox:metadata": "node scripts/submit.js firefox-metadata",
    "submit:all": "node scripts/submit.js all",
    "submit:dry-run": "node scripts/submit.js all --dry-run",
    "release": "pnpm run build:all && pnpm run submit:all",
    "test:publishing": "node --test scripts/publishing.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@parcel/config-webextension": "^2.16.4",
    "@parcel/reporter-bundle-analyzer": "^2.16.4",
    "@parcel/reporter-bundle-buddy": "^2.16.4",
    "chrome-webstore-upload-cli": "^4.0.2",
    "jsdom": "^30.1.3",
    "parcel": "^2.16.4",
    "puppeteer": "^25.16.0",
    "vitest": "^5.0.5",
    "web-ext": "^9.2.0",
    "web-ext-submit": "^7.8.0"
  },
  "targets": {
    "default": {
      "engines": {
        "browsers": ">= 50%"
      }
    }
  }
}
