{
  "manifest_version": 3,
  "name": "Isometric Contributions Plus",
  "homepage_url": "https://github.com/vycdev/isometric-contributions-plus",
  "version": "1.2.8",
  "description": "Renders an isometric pixel view of GitHub contribution graphs.",
  "action": {
    "default_title": "Isometric Contributions Plus settings",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "css": ["iso.css"],
      "js": ["obelisk.min.js", "iso.js"],
      "matches": ["https://github.com/*"]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/"],
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
